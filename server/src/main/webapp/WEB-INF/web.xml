<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
    <servlet>
        <servlet-name>AssetServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.AssetServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssetServlet</servlet-name>
        <url-pattern>/assets</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppUserServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.AppUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppUserServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IssueRequestServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.IssueRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IssueRequestServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TransferRecordServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.TransferRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TransferRecordServlet</servlet-name>
        <url-pattern>/transfers</url-pattern>
    </servlet-mapping>
</web-app>
